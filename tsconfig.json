{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "allowJs": true, "checkJs": false, "noEmit": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "types": ["node", "vite/client"]
  },
  "include": ["src", "packages", "apps", "db", "tests/**/*.ts", "vite.config.ts"]
}
