DATABASE_URL=postgres://designx:designx-local-only@127.0.0.1:55432/designx
S3_ENDPOINT=http://127.0.0.1:58333
S3_REGION=us-east-1
S3_BUCKET=designx
S3_ACCESS_KEY_ID=designx-local
S3_SECRET_ACCESS_KEY=designx-local-only
PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
# Enable the product AI entry only after configuring the worker and validating its runtime.
AI_ENABLED=false
# Keep real credentials in a mode-0600, Git-ignored .env.ai.local, never here.
E2B_API_KEY=
DEEPSEEK_API_KEY=
E2B_TEMPLATE_ID=u1yrkaokyjzef8qchho5
DEEPSEEK_MODEL=deepseek-flash

# v2: independent Image API billing. No fallback model; never use a VITE_ secret.
OPENAI_API_KEY=
IMAGE_GENERATION_ENABLED=false
GENERATION_QUOTA=100
IMAGE_TIMEOUT_MS=300000
# Optional JSON rate card: model, version, textInputPerMillion, imageInputPerMillion, outputPerMillion.
# Unconfigured monetary cost remains unknown; token usage is still recorded.
OPENAI_IMAGE_PRICING_JSON=
S3_STAGING_BUCKET=designx-staging
STORAGE_DIRECT_UPLOADS_ENABLED=true
# R2: S3_REGION=auto, private buckets and browser CORS configured before launch.
# After verified full-store mirroring, preserve historical logical bucket references.
# Example: {"old-staging":{"bucket":"designx","prefix":"_legacy/old-staging/"}}
S3_BUCKET_ALIASES_JSON={}
# During storage migration, keep the previous store readable with these explicit
# settings. All new writes still use S3_*; remove only after legacy references drain.
# LEGACY_S3_ENDPOINT=http://127.0.0.1:58333
# LEGACY_S3_REGION=us-east-1
# LEGACY_S3_BUCKET=designx
# LEGACY_S3_ACCESS_KEY_ID=
# LEGACY_S3_SECRET_ACCESS_KEY=
# New sessions only; template must be immutable <template-id>:<build-id>.
DESIGNX_RUNNER_V2=false
DESIGNX_E2B_TEMPLATE=
WORKER_ROLE=all
